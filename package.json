{
	"name": "everywhereblair",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && wrangler deploy",
		"upload": "node scripts/publish.mjs",
		"unpublish": "node scripts/publish.mjs --unpublish",
		"test:publish": "node --test scripts/*.test.mjs"
	},
	"dependencies": {
		"@fontsource/fraunces": "^5.0.11",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/source-serif-4": "^5.1.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.2.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
